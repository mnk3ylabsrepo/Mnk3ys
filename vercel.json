{
  "version": 2,
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/api/favicon" },
    { "source": "/favicon.svg", "destination": "/api/favicon.svg" },
    { "source": "/pairs", "destination": "/api/pairs" },
    { "source": "/pairs/", "destination": "/api/pairs" },

    { "source": "/blup3ts", "destination": "/preview/blup3ts/index.html" },
    { "source": "/blup3ts/", "destination": "/preview/blup3ts/index.html" },
    { "source": "/blup3ts/:path*", "destination": "/preview/blup3ts/:path*" },

    { "source": "/blupa1rs", "destination": "/preview/blupa1rs/index.html" },
    { "source": "/blupa1rs/", "destination": "/preview/blupa1rs/index.html" },
    { "source": "/blupa1rs/:path*", "destination": "/preview/blupa1rs/:path*" }
  ],
  "redirects": [
    { "source": "/Mnk3ys", "destination": "/", "permanent": false },
    { "source": "/Mnk3ys/", "destination": "/", "permanent": false },
    { "source": "/preview2", "destination": "/", "permanent": true },
    { "source": "/preview2/", "destination": "/", "permanent": true },
    { "source": "/preview/blup3ts", "destination": "/blup3ts/", "permanent": true },
    { "source": "/preview/blup3ts/", "destination": "/blup3ts/", "permanent": true },
    { "source": "/preview/blupa1rs", "destination": "/blupa1rs/", "permanent": true },
    { "source": "/preview/blupa1rs/", "destination": "/blupa1rs/", "permanent": true }
  ]
}
